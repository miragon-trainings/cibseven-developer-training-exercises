# Default ignored files
/shelf/
# Editor-based HTTP Client requests
/httpRequests/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
# IntelliJ IDEA – ignore user-specific files but track shared configs (run configurations, misc.xml)
/.idea/workspace.xml
/.idea/tasks.xml
/.idea/dictionaries
/.idea/shelf
/.idea/*.iml
.DS_Store
.vscode
.claude/*
# Der Review-Skill für die Trainingsaufgaben gehört ins Repository:
!.claude/skills
.claude/skills/*
!.claude/skills/aufgaben-review

# Maven
target/
.claude/logs/

# Local secrets (e.g. TEAMS_WEBHOOK_URL) — never commit the real .env
.env

# Node tooling
node_modules/

# Backups written by the load-solution task (services/process-application)
.load-solution-backup/
