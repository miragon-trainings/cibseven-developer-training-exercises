meta {
  name: Confirm Membership
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/memberships/{{membershipId}}/confirm
  body: none
  auth: none
}

docs {
  Confirms a waiting membership – a business REST endpoint that completes the waiting
  `userTask_confirmMembership` via the TaskService (controller → use case → adapter), instead
  of clicking it in the Tasklist. Available from Exercise 3 on. Uses the `membershipId`
  captured by `Register Membership`; set it manually if you start here.
}
