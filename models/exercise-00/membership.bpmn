<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1d2hcmz" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="innerCircleMembership" name="Miravelo Inner Circle Membership" isExecutable="false">
    <bpmn:startEvent id="startEvent_submitRegistration" name="Submit registration form">
      <bpmn:outgoing>flow_submitRegistrationToClaimMembership</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0rxlo7x" messageRef="Message_3p5jpc1" />
    </bpmn:startEvent>
    <bpmn:subProcess id="subProcess_confirmMembership" name="Confirm membership">
      <bpmn:incoming>flow_hasEmptySpotsToConfirmMembership</bpmn:incoming>
      <bpmn:outgoing>flow_confirmMembershipToNotifyFork</bpmn:outgoing>
      <bpmn:startEvent id="startEvent_confirmationRequired" name="Confirmation required">
        <bpmn:outgoing>flow_confirmationRequiredToSendConfirmationMail</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="serviceTask_sendConfirmationMail" name="Send confirmation mail">
        <bpmn:incoming>flow_confirmationRequiredToSendConfirmationMail</bpmn:incoming>
        <bpmn:outgoing>flow_sendConfirmationMailToConfirmMembership</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="userTask_confirmMembership" name="Confirm membership">
        <bpmn:incoming>flow_sendConfirmationMailToConfirmMembership</bpmn:incoming>
        <bpmn:outgoing>flow_confirmMembershipToMembershipConfirmed</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="endEvent_membershipConfirmed" name="Membership confirmed">
        <bpmn:incoming>flow_confirmMembershipToMembershipConfirmed</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_confirmationRequiredToSendConfirmationMail" sourceRef="startEvent_confirmationRequired" targetRef="serviceTask_sendConfirmationMail" />
      <bpmn:sequenceFlow id="flow_sendConfirmationMailToConfirmMembership" sourceRef="serviceTask_sendConfirmationMail" targetRef="userTask_confirmMembership" />
      <bpmn:sequenceFlow id="flow_confirmMembershipToMembershipConfirmed" sourceRef="userTask_confirmMembership" targetRef="endEvent_membershipConfirmed" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="gateway_notifyFork">
      <bpmn:incoming>flow_confirmMembershipToNotifyFork</bpmn:incoming>
      <bpmn:outgoing>flow_notifyForkToSendWelcomeMail</bpmn:outgoing>
      <bpmn:outgoing>flow_notifyForkToNotifyCommunity</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="serviceTask_sendWelcomeMail" name="Send Welcome Mail">
      <bpmn:incoming>flow_notifyForkToSendWelcomeMail</bpmn:incoming>
      <bpmn:outgoing>flow_sendWelcomeMailToNotifyJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="serviceTask_notifyCommunity" name="Notify community">
      <bpmn:incoming>flow_notifyForkToNotifyCommunity</bpmn:incoming>
      <bpmn:outgoing>flow_notifyCommunityToNotifyJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="gateway_notifyJoin">
      <bpmn:incoming>flow_sendWelcomeMailToNotifyJoin</bpmn:incoming>
      <bpmn:incoming>flow_notifyCommunityToNotifyJoin</bpmn:incoming>
      <bpmn:outgoing>flow_notifyJoinToMembershipActivated</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="endEvent_membershipActivated" name="Membership activated">
      <bpmn:incoming>flow_notifyJoinToMembershipActivated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="serviceTask_claimMembership" name="Claim membership">
      <bpmn:incoming>flow_submitRegistrationToClaimMembership</bpmn:incoming>
      <bpmn:outgoing>flow_claimMembershipToHasEmptySpots</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_hasEmptySpots" name="Has empty spots" default="flow_hasEmptySpotsToConfirmMembership">
      <bpmn:incoming>flow_claimMembershipToHasEmptySpots</bpmn:incoming>
      <bpmn:outgoing>flow_hasEmptySpotsToConfirmMembership</bpmn:outgoing>
      <bpmn:outgoing>flow_hasEmptySpotsToSendRejectionMail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="endEvent_membershipRejected" name="Membership rejected">
      <bpmn:incoming>flow_sendRejectionMailToMembershipRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="serviceTask_sendRejectionMail" name="Send rejection mail">
      <bpmn:incoming>flow_hasEmptySpotsToSendRejectionMail</bpmn:incoming>
      <bpmn:outgoing>flow_sendRejectionMailToMembershipRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="serviceTask_reSendConfirmationMail" name="Re-Send confirmation mail">
      <bpmn:incoming>flow_resendEveryDayToReSendConfirmationMail</bpmn:incoming>
      <bpmn:outgoing>flow_reSendConfirmationMailToMailSentAgain</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endEvent_mailSentAgain" name="Mail sent again">
      <bpmn:incoming>flow_reSendConfirmationMailToMailSentAgain</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gateway_declinedJoin">
      <bpmn:incoming>flow_abortAfter3HalfDaysToMembershipDeclined</bpmn:incoming>
      <bpmn:incoming>flow_confirmationRejectedToMembershipDeclined</bpmn:incoming>
      <bpmn:outgoing>flow_declinedJoinToMembershipDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="endEvent_membershipDeclined" name="Membership declined">
      <bpmn:incoming>flow_declinedJoinToMembershipDeclined</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_abortAfter3HalfDaysToMembershipDeclined" sourceRef="event_abortAfter3HalfDays" targetRef="gateway_declinedJoin" />
    <bpmn:sequenceFlow id="flow_confirmationRejectedToMembershipDeclined" sourceRef="event_confirmationRejected" targetRef="gateway_declinedJoin" />
    <bpmn:sequenceFlow id="flow_declinedJoinToMembershipDeclined" sourceRef="gateway_declinedJoin" targetRef="endEvent_membershipDeclined" />
    <bpmn:boundaryEvent id="event_abortAfter3HalfDays" name="After 3&#10;1/2 days" attachedToRef="subProcess_confirmMembership">
      <bpmn:outgoing>flow_abortAfter3HalfDaysToMembershipDeclined</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1ipk14c">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3DT12H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="event_confirmationRejected" name="Confirmation rejected" attachedToRef="subProcess_confirmMembership">
      <bpmn:outgoing>flow_confirmationRejectedToMembershipDeclined</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0po7vrz" messageRef="Message_ConfirmationRejected" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="event_resendEveryDay" name="Every day" cancelActivity="false" attachedToRef="subProcess_confirmMembership">
      <bpmn:outgoing>flow_resendEveryDayToReSendConfirmationMail</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1f4kmf0">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_notifyForkToSendWelcomeMail" sourceRef="gateway_notifyFork" targetRef="serviceTask_sendWelcomeMail" />
    <bpmn:sequenceFlow id="flow_notifyForkToNotifyCommunity" sourceRef="gateway_notifyFork" targetRef="serviceTask_notifyCommunity" />
    <bpmn:sequenceFlow id="flow_sendWelcomeMailToNotifyJoin" sourceRef="serviceTask_sendWelcomeMail" targetRef="gateway_notifyJoin" />
    <bpmn:sequenceFlow id="flow_notifyCommunityToNotifyJoin" sourceRef="serviceTask_notifyCommunity" targetRef="gateway_notifyJoin" />
    <bpmn:sequenceFlow id="flow_notifyJoinToMembershipActivated" sourceRef="gateway_notifyJoin" targetRef="endEvent_membershipActivated" />
    <bpmn:sequenceFlow id="flow_submitRegistrationToClaimMembership" sourceRef="startEvent_submitRegistration" targetRef="serviceTask_claimMembership" />
    <bpmn:sequenceFlow id="flow_hasEmptySpotsToConfirmMembership" name="Yes" sourceRef="gateway_hasEmptySpots" targetRef="subProcess_confirmMembership" />
    <bpmn:sequenceFlow id="flow_confirmMembershipToNotifyFork" sourceRef="subProcess_confirmMembership" targetRef="gateway_notifyFork" />
    <bpmn:sequenceFlow id="flow_claimMembershipToHasEmptySpots" sourceRef="serviceTask_claimMembership" targetRef="gateway_hasEmptySpots" />
    <bpmn:sequenceFlow id="flow_hasEmptySpotsToSendRejectionMail" name="No" sourceRef="gateway_hasEmptySpots" targetRef="serviceTask_sendRejectionMail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!hasEmptySpots}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_sendRejectionMailToMembershipRejected" sourceRef="serviceTask_sendRejectionMail" targetRef="endEvent_membershipRejected" />
    <bpmn:sequenceFlow id="flow_resendEveryDayToReSendConfirmationMail" sourceRef="event_resendEveryDay" targetRef="serviceTask_reSendConfirmationMail" />
    <bpmn:sequenceFlow id="flow_reSendConfirmationMailToMailSentAgain" sourceRef="serviceTask_reSendConfirmationMail" targetRef="endEvent_mailSentAgain" />
  </bpmn:process>
  <bpmn:message id="Message_3p5jpc1" name="Registration submitted" />
  <bpmn:message id="Message_ConfirmationRejected" name="Confirmation rejected" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="innerCircleMembership">
