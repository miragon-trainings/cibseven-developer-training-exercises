<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.20.0"
                  modeler:executionPlatform="Camunda Platform"
                  modeler:executionPlatformVersion="7.24.0">

  <bpmn:process id="subscribeNewsletter"
                name="Join Inner Circle"
                isExecutable="true"
                camunda:historyTimeToLive="180">

    <bpmn:startEvent id="startEvent_membershipWanted" name="Membership wanted">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="email" label="E-Mail" type="string"/>
          <camunda:formField id="name" label="Name" type="string"/>
          <camunda:formField id="age" label="Age" type="long"/>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_membershipWantedToConfirmMembership</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="flow_membershipWantedToConfirmMembership"
                       sourceRef="startEvent_membershipWanted"
                       targetRef="userTask_confirmMembership"/>

    <bpmn:userTask id="userTask_confirmMembership" name="Confirm membership">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="email" label="E-Mail" type="string"/>
          <camunda:formField id="confirmed" label="Confirm membership" type="boolean"/>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_membershipWantedToConfirmMembership</bpmn:incoming>
      <bpmn:outgoing>flow_confirmMembershipToSendWelcomeMail</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="flow_confirmMembershipToSendWelcomeMail"
                       sourceRef="userTask_confirmMembership"
                       targetRef="serviceTask_sendWelcomeMail"/>

    <bpmn:serviceTask id="serviceTask_sendWelcomeMail"
                      name="Send Welcome Mail"
                      camunda:delegateExpression="#{sendWelcomeMailDelegate}">
      <bpmn:incoming>flow_confirmMembershipToSendWelcomeMail</bpmn:incoming>
      <bpmn:outgoing>flow_sendWelcomeMailToMemberJoined</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="flow_sendWelcomeMailToMemberJoined"
                       sourceRef="serviceTask_sendWelcomeMail"
                       targetRef="endEvent_memberJoined"/>

    <bpmn:endEvent id="endEvent_memberJoined" name="Member joined">
      <bpmn:incoming>flow_sendWelcomeMailToMemberJoined</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="subscribeNewsletter">
      <bpmndi:BPMNShape id="startEvent_membershipWanted_di" bpmnElement="startEvent_membershipWanted">
        <dc:Bounds x="152" y="82" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="128" y="125" width="84" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_confirmMembership_di" bpmnElement="userTask_confirmMembership">
        <dc:Bounds x="250" y="60" width="100" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_sendWelcomeMail_di" bpmnElement="serviceTask_sendWelcomeMail">
        <dc:Bounds x="410" y="60" width="100" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_memberJoined_di" bpmnElement="endEvent_memberJoined">
        <dc:Bounds x="572" y="82" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="551" y="125" width="78" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_membershipWantedToConfirmMembership_di" bpmnElement="flow_membershipWantedToConfirmMembership">
        <di:waypoint x="188" y="100"/>
        <di:waypoint x="250" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_confirmMembershipToSendWelcomeMail_di" bpmnElement="flow_confirmMembershipToSendWelcomeMail">
        <di:waypoint x="350" y="100"/>
        <di:waypoint x="410" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sendWelcomeMailToMemberJoined_di" bpmnElement="flow_sendWelcomeMailToMemberJoined">
        <di:waypoint x="510" y="100"/>
        <di:waypoint x="572" y="100"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
