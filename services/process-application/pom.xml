<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.miragon</groupId>
        <artifactId>cibseven-developer-training-exercises</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>process-application</artifactId>
    <name>process-application</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Embedded H2 database: the engine and JPA need no external database server -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- H2 web console (http://localhost:8080/h2-console) for looking into the engine tables -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <!--
          TODO Exercise 1: Uncomment the CIB Seven starters so the engine starts with
          the web Cockpit and REST API. The versions come centrally from the root pom.xml
          (dependencyManagement) – so you add the deps WITHOUT a <version>.
        -->
        <!-- CIB Seven engine + Cockpit webapp + REST API (version managed centrally)
        <dependency>
            <groupId>org.cibseven.bpm.springboot</groupId>
            <artifactId>cibseven-bpm-spring-boot-starter-webapp-4</artifactId>
        </dependency>
        <dependency>
            <groupId>org.cibseven.bpm.springboot</groupId>
            <artifactId>cibseven-bpm-spring-boot-starter-rest-4</artifactId>
        </dependency>
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Engine CORE (classes only) so the provided process-test helper
          src/test/.../process/util/ProcessEngineTestUtils.java compiles while the CIB Seven
          starters are still commented out (before Exercise 1). Version managed centrally.
          Important: NO test scope – from Exercise 1 the starters pull the same engine transitively
          as compile; a direct test scope would downgrade it to test via Maven nearest-wins and
          take the engine away from the running app. The engine STILL only starts with the starters
          from Exercise 1 (autoconfiguration + Cockpit + REST) – this entry only puts the classes
          on the classpath, no runtime behavior.
        -->
        <dependency>
            <groupId>org.cibseven.bpm</groupId>
            <artifactId>cibseven-engine</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.miragon.training.TrainingApplication</mainClass>
                </configuration>
            </plugin>

            <!-- "Load solution": replaces src/main and also brings over the tests.
                 Call with:
                 mvn -pl services/process-application antrun:run@load-solution -Dsolution=NN   (NN = 01–09) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>load-solution</id>
                        <phase>none</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                <fail unless="solution"
                                      message="Please provide the solution number as two digits, e.g.: mvn -pl services/process-application antrun:run@load-solution -Dsolution=02"/>
                                <condition property="solutionModuleDir" value="exercise-10/process-application">
                                    <equals arg1="${solution}" arg2="10"/>
                                </condition>
                                <property name="solutionModuleDir" value="exercise-${solution}"/>
                                <property name="solutionSrc"
                                          location="${maven.multiModuleProjectDirectory}/solutions/${solutionModuleDir}/src"/>
                                <fail message="Solution '${solutionModuleDir}' not found (valid values: 01-10, two-digit). Expected path: ${solutionSrc}">
                                    <condition>
                                        <not>
                                            <available file="${solutionSrc}" type="dir"/>
                                        </not>
                                    </condition>
                                </fail>
                                <echo message="Loading solution ${solution} into the process-application module ..."/>
                                <delete dir="${project.basedir}/src/main"/>
                                <copy todir="${project.basedir}/src/main">
                                    <fileset dir="${solutionSrc}/main"/>
                                </copy>
                                <available file="${solutionSrc}/test" type="dir" property="solutionHasTests"/>
                                <delete dir="${project.basedir}/src/test/java/io/miragon/training/process" if:set="solutionHasTests"/>
                                <delete dir="${project.basedir}/src/test/resources" if:set="solutionHasTests"/>
                                <copy todir="${project.basedir}/src/test" overwrite="true" if:set="solutionHasTests">
                                    <fileset dir="${solutionSrc}/test"/>
                                </copy>
                                <echo if:set="solutionHasTests" message="Done. Solution ${solution} (src/main + process test) was copied to services/process-application; ArchitectureTest is preserved."/>
                                <echo unless:set="solutionHasTests" message="Done. Solution ${solution} (src/main) was copied; src/test unchanged (no solution test, placeholder stays)."/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
