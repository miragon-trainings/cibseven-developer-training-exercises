<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.miragon</groupId>
        <artifactId>solution-exercise-07</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>solution-exercise-07-logistics-service</artifactId>
    <name>solution-exercise-07-logistics-service</name>

    <properties>
        <!-- Package the generated /engine-rest client lands in. -->
        <cibseven-client.package>org.cibseven.rest.client</cibseven-client.package>
    </properties>

    <dependencies>
        <!-- spring-web: RestClient (Deployment + generierter Client) + der kleine REST-Controller;
             ein leichter HTTP-Server läuft auf :8090 (kollidiert nicht mit der Engine auf :8080) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- CIB Seven External Task Client (Richtung 1: Engine -> Worker) -->
        <dependency>
            <groupId>org.cibseven.bpm.springboot</groupId>
            <artifactId>cibseven-bpm-spring-boot-starter-external-task-client</artifactId>
        </dependency>
        <!-- The generated /engine-rest client is self-contained on Jackson 2 (it builds its own
             ObjectMapper + RestClient converters). Spring Boot 4's starter-web ships Jackson 3, so we
             pin the Jackson 2 artifacts the generated code compiles against explicitly (BOM-managed
             versions, kept in sync with each other). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <!-- @jakarta.annotation.Generated / @Nonnull referenced by the generated client -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <!-- Runtime-Typen der bpmn-to-code generierten Process-API -->
        <dependency>
            <groupId>io.miragon</groupId>
            <artifactId>bpmn-to-code-runtime</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Standalone in-memory engine for the process test — this service OWNS the model. -->
        <dependency>
            <groupId>org.cibseven.bpm</groupId>
            <artifactId>cibseven-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- BpmnAwareTests (isWaitingAt / hasPassed / isEnded) for expressive process-topology asserts -->
        <dependency>
            <groupId>org.cibseven.bpm</groupId>
            <artifactId>cibseven-bpm-assert</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1. Generate the typed /engine-rest client from CIB seven's official OpenAPI spec.
                    Step 1: unpack the bundled openapi.json from the spec artifact (pinned to the engine
                    version, so client and engine never drift). Step 2: run the OpenAPI Generator. The
                    generated sources land under target/generated-sources and are added to the compile
                    path automatically; nothing is committed. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>extract-openapi-spec</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.cibseven.bpm</groupId>
                                    <artifactId>cibseven-engine-rest-openapi</artifactId>
                                    <version>${cib7.version}</version>
                                    <type>jar</type>
                                    <includes>openapi.json</includes>
                                    <outputDirectory>${project.build.directory}/openapi</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-cibseven-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.build.directory}/openapi/openapi.json</inputSpec>
                            <generatorName>java</generatorName>
                            <library>restclient</library>
                            <apiPackage>${cibseven-client.package}.api</apiPackage>
                            <modelPackage>${cibseven-client.package}.model</modelPackage>
                            <invokerPackage>${cibseven-client.package}.invoker</invokerPackage>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <validateSpec>false</validateSpec>
                            <configOptions>
                                <serializationLibrary>jackson</serializationLibrary>
                                <useJakartaEe>true</useJakartaEe>
                                <openApiNullable>false</openApiNullable>
                                <dateLibrary>java8</dateLibrary>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. bpmn-to-code: typsichere Process-API aus dem EIGENEN BPMN-Modell. -->
            <plugin>
                <groupId>io.miragon</groupId>
                <artifactId>bpmn-to-code-maven</artifactId>
                <executions>
                    <execution>
                        <id>generate-process-api</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-bpmn-api</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <baseDir>${project.basedir}</baseDir>
                    <filePattern>src/main/resources/bpmn/*.bpmn</filePattern>
                    <outputFolderPath>${project.basedir}/src/main/java</outputFolderPath>
                    <packagePath>io.miragon.training.adapter.process</packagePath>
                    <outputLanguage>JAVA</outputLanguage>
                    <processEngine>CAMUNDA_7</processEngine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.miragon.training.TrainingWorkerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
