<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.miragon</groupId>
        <artifactId>solution-exercise-07</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>solution-exercise-07-logistics-service</artifactId>
    <name>solution-exercise-07-logistics-service</name>


    <dependencies>
        <!-- spring-web: the small REST controller; a lightweight HTTP server runs on :8090
             (does not collide with the engine on :8080) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- CIB seven community REST client (github.com/cibseven-community-hub/cibseven-rest-client-java):
             the typed /engine-rest client (Direction 2: service -> engine), the External Task Client
             (Direction 1: engine -> worker) and the auto-deployment of the owned BPMN in one starter -->
        <dependency>
            <groupId>org.cibseven.community.rest-client</groupId>
            <artifactId>cibseven-engine-rest-client-complete-springboot-starter</artifactId>
        </dependency>
        <!-- The REST client brings the javax JAXB API along, which makes the External Task Client load
             its XML data format; that one needs the Jakarta JAXB API at runtime -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Runtime-Typen der bpmn-to-code generierten Process-API -->
        <dependency>
            <groupId>io.miragon</groupId>
            <artifactId>bpmn-to-code-runtime</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Standalone in-memory engine for the process test — this service OWNS the model. -->
        <dependency>
            <groupId>org.cibseven.bpm</groupId>
            <artifactId>cibseven-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- BpmnAwareTests (isWaitingAt / hasPassed / isEnded) for expressive process-topology asserts -->
        <dependency>
            <groupId>org.cibseven.bpm</groupId>
            <artifactId>cibseven-bpm-assert</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- bpmn-to-code: typsichere Process-API aus dem EIGENEN BPMN-Modell. -->
            <plugin>
                <groupId>io.miragon</groupId>
                <artifactId>bpmn-to-code-maven</artifactId>
                <executions>
                    <execution>
                        <id>generate-process-api</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-bpmn-api</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <baseDir>${project.basedir}</baseDir>
                    <filePattern>src/main/resources/bpmn/*.bpmn</filePattern>
                    <outputFolderPath>${project.basedir}/src/main/java</outputFolderPath>
                    <packagePath>io.miragon.training.adapter.process</packagePath>
                    <outputLanguage>JAVA</outputLanguage>
                    <processEngine>CAMUNDA_7</processEngine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.miragon.training.TrainingWorkerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
