    </parent>

    <artifactId>solution-exercise-07</artifactId>
    <packaging>pom</packaging>
    <name>solution-exercise-07</name>

    <!--
      Aufgabe 7 zeigt die Engine als wiederverwendbare Infrastruktur (Pattern A: "you build it, you run it").
      Sie besteht aus ZWEI Services (jeder in einer eigenen JVM):
        - process-application: der geteilte Engine-Host (embedded Engine + /engine-rest + Cockpit). Beim
          Aktivieren eines Members broadcastet er das Signal "Signal_MemberActivated".
        - logistics-service: der Remote-Owner eines EIGENEN kleinen Prozesses (sendWelcomeKit). Er besitzt
          das Modell, deployt es selbst per REST in die Engine, hört per Signal-Start-Event darauf, erfüllt
          den Service-Task als External Task und treibt die Engine über den generierten Client.

      Den typisierten /engine-rest-Client generiert der logistics-service selbst aus der offiziellen
      OpenAPI-Spec (openapi-generator-maven-plugin) – kein separates Client-Modul mehr.
    -->
    <modules>
        <module>process-application</module>
        <module>logistics-service</module>
    </modules>

</project>
