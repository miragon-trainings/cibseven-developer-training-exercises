<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.miragon</groupId>
        <artifactId>solution-extra-task-1</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>solution-extra-task-1-logistics-service</artifactId>
    <name>solution-extra-task-1-logistics-service</name>


    <dependencies>
        <!-- spring-web: the small REST controller; a lightweight HTTP server runs on :8090
             (does not collide with the engine on :8080) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- bpm-crafters process-engine-api layer -->
        <!-- Engine-neutral process orchestration API (start, correlate, workers) -->
        <dependency>
            <groupId>dev.bpm-crafters.process-engine-api</groupId>
            <artifactId>process-engine-api</artifactId>
            <version>${process-engine-api.version}</version>
        </dependency>
        <!-- @ProcessEngineWorker support (replaces the external-task-client handler) -->
        <dependency>
            <groupId>dev.bpm-crafters.process-engine-worker</groupId>
            <artifactId>process-engine-worker-spring-boot-starter</artifactId>
            <version>${process-engine-worker.version}</version>
        </dependency>
        <!-- CIB Seven adapter: plugs the process-engine-api onto the REMOTE engine via /engine-rest -->
        <dependency>
            <groupId>dev.bpm-crafters.process-engine-adapters</groupId>
            <artifactId>process-engine-adapter-cib-seven-remote-spring-boot-starter</artifactId>
            <version>${process-engine-adapter-cib7.version}</version>
        </dependency>
        <!-- Typed-variable API the remote adapter maps process variables with; it declares it as
             'provided', so a service without an engine has to bring it itself -->
        <dependency>
            <groupId>org.cibseven.commons</groupId>
            <artifactId>cibseven-commons-typed-values</artifactId>
            <version>${cib7.version}</version>
        </dependency>
        <!-- Runtime-Typen der bpmn-to-code generierten Process-API -->
        <dependency>
            <groupId>io.miragon</groupId>
            <artifactId>bpmn-to-code-runtime</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Standalone in-memory engine for the process test — this service OWNS the model. -->
        <dependency>
            <groupId>org.cibseven.bpm</groupId>
            <artifactId>cibseven-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- BpmnAwareTests (isWaitingAt / hasPassed / isEnded) for expressive process-topology asserts -->
        <dependency>
            <groupId>org.cibseven.bpm</groupId>
            <artifactId>cibseven-bpm-assert</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- bpmn-to-code: typsichere Process-API aus dem EIGENEN BPMN-Modell. -->
            <plugin>
                <groupId>io.miragon</groupId>
                <artifactId>bpmn-to-code-maven</artifactId>
                <executions>
                    <execution>
                        <id>generate-process-api</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-bpmn-api</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <baseDir>${project.basedir}</baseDir>
                    <filePattern>src/main/resources/bpmn/*.bpmn</filePattern>
                    <outputFolderPath>${project.basedir}/src/main/java</outputFolderPath>
                    <packagePath>io.miragon.training.adapter.process</packagePath>
                    <outputLanguage>JAVA</outputLanguage>
                    <processEngine>CAMUNDA_7</processEngine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.miragon.training.TrainingWorkerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
