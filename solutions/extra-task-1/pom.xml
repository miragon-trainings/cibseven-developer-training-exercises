<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.miragon</groupId>
        <artifactId>solutions</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>solution-extra-task-1</artifactId>
    <packaging>pom</packaging>
    <name>solution-extra-task-1</name>

    <!--
      Reference solution for Extra Task 1 – the same two services as in Exercise 7, both on the
      bpm-crafters process-engine-api:
        - process-application: the engine host, through the CIB seven EMBEDDED adapter.
        - logistics-service: the remote owner of sendWelcomeKit, through the CIB seven REMOTE adapter.
      Only the adapter dependency + its configuration differ; the code against the API looks the same.
    -->
    <modules>
        <module>process-application</module>
        <module>logistics-service</module>
    </modules>

    <properties>
        <!-- bpm-crafters process-engine-api: engine-neutral abstraction layer -->
        <process-engine-api.version>1.7</process-engine-api.version>
        <process-engine-worker.version>0.8.5</process-engine-worker.version>
        <process-engine-adapter-cib7.version>2026.09.1</process-engine-adapter-cib7.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Aligns the versions of the CIB Seven process-engine-adapter modules -->
            <dependency>
                <groupId>dev.bpm-crafters.process-engine-adapters</groupId>
                <artifactId>process-engine-adapter-cib-seven-bom</artifactId>
                <version>${process-engine-adapter-cib7.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
