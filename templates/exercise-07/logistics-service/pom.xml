<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.miragon</groupId>
        <artifactId>cibseven-developer-training-exercises</artifactId>
        <version>1.0-SNAPSHOT</version>
        <!-- Correct once the module lives at services/logistics-service (its home after you copy it in
             Exercise 7): ../../pom.xml is the repo root. While it still sits under templates/ (only the CI
             check builds it there), CI installs the root pom first so the parent resolves from the repo. -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>logistics-service</artifactId>
    <name>logistics-service</name>

    <!--
      Exercise 7 – skeleton of the logistics service (remote owner of the sendWelcomeKit process).

      Fill in the TODO Exercise 7 spots:
        1. Model the process + generate the Process-API -> send-welcome-kit.bpmn + the bpmn-to-code block below.
        2. Implement the external-task worker            -> ShipWelcomeKitWorker.
        3. Start the process via the typed client        -> RemoteWelcomeKitProcessAdapter.

      Engine client, External Task Client and the deployment of the owned model come ready-made from the
      CIB seven community REST client (see dependencies + application.yaml).

      Reference solution: solutions/exercise-07/logistics-service.
    -->


    <dependencies>
        <!-- spring-web: the small REST controller. A lightweight HTTP server runs on :8090
             (does not collide with the engine on :8080). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- CIB seven community REST client (github.com/cibseven-community-hub/cibseven-rest-client-java):
             the typed /engine-rest client (Direction 2: service -> engine), the External Task Client
             (Direction 1: engine -> worker) and the auto-deployment of the owned BPMN in one starter -->
        <dependency>
            <groupId>org.cibseven.community.rest-client</groupId>
            <artifactId>cibseven-engine-rest-client-complete-springboot-starter</artifactId>
        </dependency>
        <!-- The REST client brings the javax JAXB API along, which makes the External Task Client load
             its XML data format; that one needs the Jakarta JAXB API at runtime -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Runtime types of the bpmn-to-code generated Process-API -->
        <dependency>
            <groupId>io.miragon</groupId>
            <artifactId>bpmn-to-code-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- bpmn-to-code: type-safe Process-API from the OWNED BPMN model (already active). -->
            <!-- ============================================================================
                 TODO Exercise 7 (step 1): Generate the type-safe Process-API.

                 From your BPMN model, bpmn-to-code produces constants for element IDs, topics, etc.
                 It generates a topic constant (ServiceTasks.SHIP_WELCOME_KIT)
                 but ONLY once you have modelled the process (incl. an external service task with a topic) –
                 that is why this block is commented out. Order:
                   1. Model the sendWelcomeKit process in send-welcome-kit.bpmn (see docs/en/exercise-07.md).
                   2. Uncomment this block.
                   3. `./mvnw -pl services/logistics-service generate-sources`
                      -> SendWelcomeKitProcessApi appears; the worker can subscribe to the topic constant.
                 ============================================================================ -->
            <!--
            <plugin>
                <groupId>io.miragon</groupId>
                <artifactId>bpmn-to-code-maven</artifactId>
                <executions>
                    <execution>
                        <id>generate-process-api</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-bpmn-api</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <baseDir>${project.basedir}</baseDir>
                    <filePattern>src/main/resources/bpmn/*.bpmn</filePattern>
                    <outputFolderPath>${project.basedir}/src/main/java</outputFolderPath>
                    <packagePath>io.miragon.training.adapter.process</packagePath>
                    <outputLanguage>JAVA</outputLanguage>
                    <processEngine>CAMUNDA_7</processEngine>
                </configuration>
            </plugin>
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.miragon.training.TrainingWorkerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
