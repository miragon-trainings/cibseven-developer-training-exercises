<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.miragon</groupId>
        <artifactId>cibseven-developer-training-exercises</artifactId>
        <version>1.0-SNAPSHOT</version>
        <!-- Correct once the module lives at services/logistics-service (its home after you copy it in
             Exercise 10): ../../pom.xml is the repo root. While it still sits under templates/ (only the CI
             check builds it there), CI installs the root pom first so the parent resolves from the repo. -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>logistics-service</artifactId>
    <name>logistics-service</name>

    <!--
      Exercise 10 – skeleton of the logistics service (remote owner of the sendWelcomeKit process).

      Fill in the TODO Exercise 10 spots:
        1. Generate the typed /engine-rest client   -> the commented-out plugin block below.
        2. Wire up the client beans                  -> EngineClientConfig.
        3. Deploy the model yourself                 -> EngineDeploymentAdapter.
        4. Implement the external-task worker        -> ShipWelcomeKitWorker.
        5. Start the engine via the client           -> RemoteWelcomeKitProcessAdapter.

      Reference solution: solutions/exercise-10/logistics-service.
    -->

    <properties>
        <!-- Package the generated /engine-rest client lands in (used once you enable the generator). -->
        <cibseven-client.package>org.cibseven.rest.client</cibseven-client.package>
    </properties>

    <dependencies>
        <!-- spring-web: RestClient (deployment + generated client) + the small REST controller.
             A lightweight HTTP server runs on :8090 (does not collide with the engine on :8080). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- CIB Seven External Task Client (Direction 1: Engine -> Worker) -->
        <dependency>
            <groupId>org.cibseven.bpm.springboot</groupId>
            <artifactId>cibseven-bpm-spring-boot-starter-external-task-client</artifactId>
        </dependency>
        <!-- The generated client is self-contained on Jackson 2 (Spring Boot 4 uses Jackson 3),
             hence the Jackson 2 artifacts + jakarta.annotation explicitly (BOM-managed versions). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <!-- Runtime types of the bpmn-to-code generated Process-API -->
        <dependency>
            <groupId>io.miragon</groupId>
            <artifactId>bpmn-to-code-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

